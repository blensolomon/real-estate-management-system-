generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  AGENT
  ACCOUNTANT
  ADMIN
}

enum PayoutStatus {
  APPROVED
  PAID
}

enum CalendarPref {
  ETHIOPIAN
  GREGORIAN
}

enum LeadSource {
  FACEBOOK
  TELEGRAM
  WALK_IN
  REFERRAL
  WEBSITE
  TIKTOK
  PHONE
  BILLBOARD
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  SITE_VISIT
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  MEETING
  SITE_VISIT
  TELEGRAM
  NOTE
  STATUS_CHANGE
  REASSIGNED
}

enum TaskType {
  CALL
  MESSAGE
  SITE_VISIT
  MEETING
  OTHER
}

enum VisitOutcome {
  INTERESTED
  NEEDS_TIME
  NOT_INTERESTED
  NO_SHOW
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  HANDED_OVER
  BLOCKED
}

enum UnitKind {
  APARTMENT
  PLOT
}

enum PlanType {
  CASH
  INSTALLMENT
  MORTGAGE
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  CONVERTED
}

enum DealStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  TELEBIRR
  CBE_BIRR
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  VOID
}

enum DocumentType {
  CONTRACT
  ID
  RECEIPT
  PAYMENT_PROOF
  TITLE
  OTHER
}

model Company {
  id                   String          @id @default(cuid())
  name                 String
  reservationDays      Int             @default(7)
  followUpDays         Int             @default(2)
  calendar             CalendarPref    @default(ETHIOPIAN)
  locale               String          @default("en")
  staleLeadDays        Int             @default(3)
  receiptSeq           Int             @default(0)
  discountApprovalPct  Decimal         @default(5) @db.Decimal(5, 2)
  /// New sales: commission becomes payable in full once this % of the price is confirmed.
  commissionPayablePct Decimal         @default(30) @db.Decimal(5, 2)
  active               Boolean         @default(true)
  suspendedAt          DateTime?
  priceApprovals       PriceApproval[]
  createdAt            DateTime        @default(now())

  users                User[]
  projects             Project[]
  units                Unit[]
  leads                Lead[]
  clients              Client[]
  reservations         Reservation[]
  deals                Deal[]
  payments             Payment[]
  documents            Document[]
  payouts              CommissionPayout[]
  auditLogs            AuditLog[]
  followUps            FollowUp[]
  activities           Activity[]
  targets              SalesTarget[]
  notifications        Notification[]
  documentRequirements DocumentRequirement[]
  commissionTiers      CommissionTier[]
  commissionSplits     CommissionSplit[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(AGENT)
  external     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  leads              Lead[]             @relation("LeadOwner")
  commissionSplits   CommissionSplit[]
  notifications      Notification[]
  activities         Activity[]
  followUps          FollowUp[]
  reservations       Reservation[]      @relation("ReservationAgent")
  depositsConfirmed  Reservation[]      @relation("DepositConfirmedBy")
  approvalsRequested PriceApproval[]    @relation("ApprovalRequestedBy")
  approvalsDecided   PriceApproval[]    @relation("ApprovalDecidedBy")
  deals              Deal[]
  paymentsRecorded   Payment[]          @relation("PaymentRecordedBy")
  paymentsConfirmed  Payment[]          @relation("PaymentConfirmedBy")
  documents          Document[]
  payouts            CommissionPayout[] @relation("PayoutAgent")
  payoutsMade        CommissionPayout[] @relation("PayoutPaidBy")
  payoutsApproved    CommissionPayout[] @relation("PayoutApprovedBy")
  targets            SalesTarget[]
  auditLogs          AuditLog[]

  @@index([companyId])
}

model Project {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  commissionRate Decimal  @default(2) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())

  units           Unit[]
  leads           Lead[]
  commissionTiers CommissionTier[]
  followUps       FollowUp[]

  @@index([companyId])
}

model Unit {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String
  block       String?
  floor       Int?
  kind        UnitKind   @default(APARTMENT)
  type        String?
  sizeSqm     Decimal?   @db.Decimal(10, 2)
  /// Plot-only fields
  zoning      String?
  titleStatus String?
  price       Decimal    @db.Decimal(14, 2)
  status      UnitStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())

  reservations Reservation[]
  deals        Deal[]

  @@unique([projectId, code])
  @@index([companyId, status])
}

model Lead {
  id                String     @id @default(cuid())
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  email             String?
  source            LeadSource
  sourceDetail      String?
  status            LeadStatus @default(NEW)
  budget            Decimal?   @db.Decimal(14, 2)
  notes             String?
  ownerId           String?
  owner             User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  interestProjectId String?
  interestProject   Project?   @relation(fields: [interestProjectId], references: [id])
  lastActivityAt    DateTime?
  lostReason        String?
  createdAt         DateTime   @default(now())

  activities Activity[]
  followUps  FollowUp[]
  clients    Client[]

  @@unique([companyId, phone])
  @@index([companyId, ownerId])
  @@index([companyId, status])
}

model Activity {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      ActivityType
  note      String?
  createdAt DateTime     @default(now())

  @@index([leadId, createdAt])
}

model FollowUp {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeId   String
  assignee     User          @relation(fields: [assigneeId], references: [id])
  type         TaskType      @default(CALL)
  dueAt        DateTime
  note         String?
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id])
  visitOutcome VisitOutcome?
  doneAt       DateTime?
  outcome      String?
  createdAt    DateTime      @default(now())

  @@index([companyId, assigneeId, doneAt])
}

model Client {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  email     String?
  idNumber  String?
  address   String?
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  createdAt DateTime @default(now())

  reservations Reservation[]
  deals        Deal[]
  documents    Document[]

  @@unique([companyId, phone])
}

model Reservation {
  id                   String            @id @default(cuid())
  companyId            String
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitId               String
  unit                 Unit              @relation(fields: [unitId], references: [id])
  clientId             String
  client               Client            @relation(fields: [clientId], references: [id])
  agentId              String
  agent                User              @relation("ReservationAgent", fields: [agentId], references: [id])
  depositAmount        Decimal           @default(0) @db.Decimal(14, 2)
  depositRef           String?
  depositConfirmedAt   DateTime?
  depositConfirmedById String?
  depositConfirmedBy   User?             @relation("DepositConfirmedBy", fields: [depositConfirmedById], references: [id])
  expiresAt            DateTime
  status               ReservationStatus @default(ACTIVE)
  note                 String?
  createdAt            DateTime          @default(now())
  closedAt             DateTime?

  deal           Deal?
  priceApprovals PriceApproval[]

  @@index([companyId, status, expiresAt])
}

model Deal {
  id                   String       @id @default(cuid())
  companyId            String
  company              Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractNo           String
  unitId               String
  unit                 Unit         @relation(fields: [unitId], references: [id])
  clientId             String
  client               Client       @relation(fields: [clientId], references: [id])
  agentId              String
  agent                User         @relation(fields: [agentId], references: [id])
  reservationId        String?      @unique
  reservation          Reservation? @relation(fields: [reservationId], references: [id])
  price                Decimal      @db.Decimal(14, 2)
  commissionRate       Decimal      @db.Decimal(5, 2)
  /// Snapshot at sale time. Null = older sale: commission unlocks gradually with collections.
  commissionPayablePct Decimal?     @db.Decimal(5, 2)
  status               DealStatus   @default(ACTIVE)
  signedAt             DateTime
  cancelReason         String?
  createdAt            DateTime     @default(now())

  plan         PaymentPlan?
  installments Installment[]
  payments     Payment[]
  documents    Document[]
  payouts      CommissionPayout[]
  splits       CommissionSplit[]

  @@unique([companyId, contractNo])
  @@index([companyId, agentId])
}

model PaymentPlan {
  id        String   @id @default(cuid())
  dealId    String   @unique
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type      PlanType
  downPct   Decimal  @default(0) @db.Decimal(5, 2)
  months    Int      @default(0)
  bankName  String?
  createdAt DateTime @default(now())
}

model Installment {
  id      String   @id @default(cuid())
  dealId  String
  deal    Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  seq     Int
  label   String
  dueDate DateTime
  amount  Decimal  @db.Decimal(14, 2)

  @@unique([dealId, seq])
}

model Payment {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId        String
  deal          Deal          @relation(fields: [dealId], references: [id])
  amount        Decimal       @db.Decimal(14, 2)
  paidAt        DateTime
  method        PaymentMethod
  reference     String?
  status        PaymentStatus @default(PENDING)
  recordedById  String
  recordedBy    User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  confirmedById String?
  confirmedBy   User?         @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  rejectReason  String?
  /// Set on a correcting entry: negative amount that cancels a confirmed payment.
  reversalOfId  String?       @unique
  reversalOf    Payment?      @relation("PaymentReversal", fields: [reversalOfId], references: [id])
  reversedBy    Payment?      @relation("PaymentReversal")
  voidReason    String?
  receiptNo     Int?
  receiptId     String?       @unique
  receipt       Document?     @relation(fields: [receiptId], references: [id])
  createdAt     DateTime      @default(now())

  @@unique([companyId, receiptNo])
  @@index([companyId, status])
  @@index([dealId])
}

model CommissionPayout {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentId      String
  agent        User         @relation("PayoutAgent", fields: [agentId], references: [id])
  dealId       String
  deal         Deal         @relation(fields: [dealId], references: [id])
  amount       Decimal      @db.Decimal(14, 2)
  status       PayoutStatus @default(APPROVED)
  approvedById String
  approvedBy   User         @relation("PayoutApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime     @default(now())
  reference    String?
  paidById     String?
  paidBy       User?        @relation("PayoutPaidBy", fields: [paidById], references: [id])
  paidAt       DateTime?

  @@index([companyId, agentId])
}

/// Monthly sales target per agent (month = first day of the month, Addis time).
model SalesTarget {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String
  amount    Decimal @db.Decimal(14, 2)

  @@unique([userId, month])
  @@index([companyId, month])
}

model Document {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type         DocumentType
  fileName     String
  storagePath  String
  mimeType     String
  size         Int
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id])
  dealId       String?
  deal         Deal?        @relation(fields: [dealId], references: [id])
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  payment Payment?

  @@index([companyId, clientId])
  @@index([companyId, dealId])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  detail    String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entity, entityId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A sale price below list price by more than Company.discountApprovalPct needs a Sales Manager/Owner decision.
model PriceApproval {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reservationId String
  reservation   Reservation    @relation(fields: [reservationId], references: [id])
  listPrice     Decimal        @db.Decimal(14, 2)
  price         Decimal        @db.Decimal(14, 2)
  reason        String?
  status        ApprovalStatus @default(PENDING)
  requestedById String
  requestedBy   User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime       @default(now())

  @@index([companyId, status])
  @@index([reservationId])
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  link      String?
  dedupeKey String?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

/// Company checklist of documents every sale should have. Missing items warn; they never block.
model DocumentRequirement {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      DocumentType
  label     String
  createdAt DateTime     @default(now())

  @@unique([companyId, type])
}

/// Price-based commission rate for a project: the highest fromAmount <= sale price wins; below every tier the project rate applies.
model CommissionTier {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromAmount Decimal  @db.Decimal(14, 2)
  rate       Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  @@unique([projectId, fromAmount])
  @@index([companyId])
}

/// Share of a deal's commission per earner. No rows = 100% to the deal's agent.
model CommissionSplit {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  sharePct  Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now())

  @@unique([dealId, userId])
  @@index([companyId])
}
