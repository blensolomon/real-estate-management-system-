DATABASE_URL="postgresql://resms:resms@localhost:5432/resms?schema=public"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
UPLOAD_DIR="./uploads"
# Session cookies are HTTPS-only in production. Set to "false" only when serving over plain HTTP
# on a private network (e.g. http://192.168.1.10:3000); browsers drop secure cookies on plain HTTP.
COOKIE_SECURE=""
# Multi-company SaaS: emails allowed to open /platform (list, suspend, reactivate companies), comma-separated.
PLATFORM_ADMIN_EMAILS=""
# Set to "false" to close public company sign-up at /register.
SIGNUP_ENABLED="true"
# Host port for docker compose (default 3000).
APP_PORT="3000"
CRON_SECRET="change-me"
# Optional S3-compatible storage for documents and payment proofs (AWS S3, Cloudflare R2, MinIO…).
# Leave S3_BUCKET empty to store files on local disk in UPLOAD_DIR.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Integration tests (npm run test:rules) use a separate database:
TEST_DATABASE_URL="postgresql://resms:resms@localhost:5432/resms_test?schema=public"
# Phase 2 notifications. In-app always; email only when SMTP_URL is set (e.g. smtps://user:pass@smtp.example.com:465).
SMTP_URL=""
SMTP_FROM="no-reply@example.com"
# Public URL used in email links, e.g. https://sales.example.com
APP_URL=""
